{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "server.ts",
    "config/**/*",
    "controllers/**/*",
    "middlewares/**/*",
    "models/**/*",
    "realtime/**/*",
    "routes/**/*",
    "utils/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}

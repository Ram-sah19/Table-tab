# Server Port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# MongoDB Atlas Connection URI
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/seamless_serve?retryWrites=true&w=majority"

# JWT Secret for Authentication
JWT_SECRET="your-secure-jwt-secret-here"

# Secret header for /api/cron/keep-alive (x-cron-secret)
CRON_SECRET="your-random-cron-secret-here"
